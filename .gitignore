# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.so.*

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Build directories
build/
Build/
build-*/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt
compile_commands.json

# NOTE: do not ignore `Makefile` here. CMake-generated makefiles always live
# inside a build directory, which `build/` and `build-*/` already cover; a bare
# `Makefile` pattern would silently swallow the hand-written ones at the repo
# root, apps/ and libs/, leaving a clone that cannot build.

# CLion build trees (they ship their own .gitignore, keep a fallback anyway)
cmake-build-*/

# Temporary files
*.tmp
*.log
*.bak
*.swp

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
.cache/

# IDs config dirs
.idea
.vscode
*/.idea/*

# Build stamps
.docker-image.stamp
docker/.image.stamp

# Artifacts produced by `make vendor`: copied into the consumer tree, never
# committed (a stale copy would silently shadow the real header).
apps/bmatrix/libs/


